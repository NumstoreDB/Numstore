--tool=memcheck
--error-exitcode=1
--leak-check=full
--show-leak-kinds=all
--errors-for-leak-kinds=all
--track-origins=yes
--track-fds=yes
--trace-children=yes
--undef-value-errors=yes
--expensive-definedness-checks=yes
--partial-loads-ok=no
--malloc-fill=0xab
--free-fill=0xcd
--keep-debuginfo=yes
--read-var-info=yes
--num-callers=50
--fair-sched=yes
--gen-suppressions=all
