<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Numstore/Numstore.csproj" />
  </ItemGroup>

  <!-- Linux test double for libnumstore; build it with tests/stub/build.sh -->
  <ItemGroup>
    <None Include="../stub/libnumstore.so" Condition="Exists('../stub/libnumstore.so')" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
