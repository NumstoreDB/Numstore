@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)

# The rust half of numstore, installed next to it as a plain static archive
if(NOT TARGET numstore::nslang)
    add_library(numstore::nslang STATIC IMPORTED)
    set_target_properties(
        numstore::nslang
        PROPERTIES
            IMPORTED_LOCATION
                "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/@CMAKE_STATIC_LIBRARY_PREFIX@nslang@CMAKE_STATIC_LIBRARY_SUFFIX@"
    )
endif()

include("${CMAKE_CURRENT_LIST_DIR}/numstoreTargets.cmake")
